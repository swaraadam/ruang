{
  "name": "@internal/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && ./scripts/audit-seams.sh && ./scripts/audit-identity.sh",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "audit": "./scripts/audit-seams.sh && ./scripts/audit-identity.sh",
    "ready": "python3 scripts/next-ready.py",
    "gate": "./scripts/gate-check.sh",
    "seed": "tsc -b tsconfig.scripts.json && node dist/scripts/seed.js",
    "dev": "./scripts/dev.sh"
  },
  "devDependencies": {
    "@internal/persistence": "workspace:*",
    "@internal/protocol": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
