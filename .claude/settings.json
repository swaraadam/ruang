{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx tsc *)",
      "Bash(python3 *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git worktree*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(gh issue*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh label*)",
      "Bash(./scripts/*)",
      "Bash(scripts/*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(sqlite3 *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "Bash(git push -u origin *)",
      "Bash(gh pr merge * --squash --delete-branch*)",
      "Bash(gh pr review*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret*)",
      "Bash(gh auth*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(curl * -d*)",
      "Bash(security *)",
      "Bash(defaults write*)",
      "Bash(launchctl load*)",
      "Bash(launchctl bootstrap*)",
      "Bash(tailscale *)",
      "Bash(cloudflared *)",
      "Read(./.env)",
      "Read(./state/secrets/**)",
      "Edit(./docs/blueprint/**)",
      "Bash(git push origin main*)",
      "Bash(git push* --force*)",
      "Bash(git push -f*)",
      "Edit(./.github/workflows/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./scripts/audit-seams.sh)",
      "Edit(./scripts/audit-identity.sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/audit-seams.sh --quiet-on-pass"
          }
        ]
      }
    ]
  }
}